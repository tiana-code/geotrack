{
  "name": "@itiana/geotrack",
  "version": "0.1.0",
  "description": "Real-time geospatial visualization toolkit for deck.gl - ocean currents, vessel trails, great-circle routes",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "maplibre-gl": ">=4.0.0",
    "react": ">=18.0.0"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/extensions": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@turf/bearing": "^7.0.0",
    "@turf/boolean-point-in-polygon": "^7.0.0",
    "@turf/great-circle": "^7.0.0",
    "@turf/helpers": "^7.0.0",
    "geojson": "^0.5.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.14",
    "@types/node": "^20.19.39",
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.9.0",
    "vitest": "^1.5.0"
  }
}
